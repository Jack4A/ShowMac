[Unit]
Description=Renew showmac IP and domain TLS certificates
Wants=network-online.target
After=network-online.target nginx.service
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/showmac-certbot renew --non-interactive --quiet --deploy-hook /usr/local/sbin/showmac-reload-nginx
TimeoutStartSec=180
NoNewPrivileges=true
